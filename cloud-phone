#!/bin/bash
# CLI for Cuttlefish ingest hosts and Redroid GApps phones.
# See docs/RUNTIME-SPLIT.md

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"

usage() {
    cat <<'EOF'
cloud-phone

Cuttlefish = virtual camera/mic ingest (nginx-rtmp + v4l2 sinks).
Redroid    = GApps phone containers for mobile IO. No camera HAL here.

Usage:
  ./cloud-phone <command> [options]

Cuttlefish (ingest):
  deploy            Create/reuse OCI host and install Cuttlefish stack
  deploy-golden     Deploy a single host from golden image
  deploy-fleet      Deploy multiple hosts from one golden image
  verify-ingest     Verify runtime + RTMP video/audio ingest
  create-golden     Create golden image from configured source instance
  prepare-golden    Prepare current host for image capture

Redroid (GApps phones):
  redroid-up        Start a Redroid container (Playwright-like phone)
  redroid-down      Stop and remove a Redroid container
  gapps-install     Install operator-supplied GApps zip into Redroid
  gapps-check       Validate Play/GMS packages on ADB

Control plane:
  api-run           Run control API locally
  orchestrator-run  Run orchestrator locally
  test              Run test suites (--coverage, --suite, --list, --live)
  help              Show this help

Examples:
  ./cloud-phone redroid-up --name phone-1 --adb-port 5555
  GAPPS_ZIP=/opt/gapps/gapps.zip ./cloud-phone gapps-install --name phone-1
  ./cloud-phone test --coverage
  ./cloud-phone deploy --name cuttlefish-source --ocpus 4 --memory 24
  ./cloud-phone verify-ingest --vm <OCI_PUBLIC_IP>
EOF
}

run_script() {
    local script="$1"
    shift
    bash "$script" "$@"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    deploy)
        run_script "$SCRIPTS_DIR/deploy-cuttlefish-oci.sh" "$@"
        ;;
    deploy-golden)
        run_script "$SCRIPTS_DIR/deploy-from-golden.sh" --platform cuttlefish "$@"
        ;;
    deploy-fleet)
        run_script "$SCRIPTS_DIR/deploy-golden-fleet.sh" --platform cuttlefish "$@"
        ;;
    verify-ingest)
        run_script "$SCRIPTS_DIR/verify-cuttlefish-ingest.sh" "$@"
        ;;
    create-golden)
        run_script "$SCRIPTS_DIR/create-golden-image.sh" "$@"
        ;;
    prepare-golden)
        run_script "$SCRIPTS_DIR/prepare-golden-image.sh" --platform cuttlefish "$@"
        ;;
    redroid-up)
        run_script "$SCRIPTS_DIR/redroid-up.sh" "$@"
        ;;
    redroid-down)
        run_script "$SCRIPTS_DIR/redroid-up.sh" --down "$@"
        ;;
    gapps-install)
        run_script "$SCRIPTS_DIR/install-gapps-redroid.sh" "$@"
        ;;
    gapps-check)
        run_script "$SCRIPTS_DIR/install-gapps-redroid.sh" --validate-only "$@"
        ;;
    test)
        run_script "$SCRIPTS_DIR/run-tests.sh" "$@"
        ;;
    api-run)
        python3 "$ROOT_DIR/api/server.py" "$@"
        ;;
    orchestrator-run)
        python3 "$ROOT_DIR/orchestrator/server.py" "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
