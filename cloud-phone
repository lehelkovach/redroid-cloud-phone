#!/bin/bash
# CLI for Redroid GApps automation phones and Cuttlefish ingest hosts.
# See docs/RUNTIME-SPLIT.md

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"

usage() {
    cat <<'EOF'
cloud-phone

Redroid    = default OCI automation pool (GApps / Play / mobile IO).
Cuttlefish = on-demand camera/mic ingest (nginx-rtmp + v4l2 sinks).

Usage:
  ./cloud-phone <command> [options]

Redroid (GApps automation pool):
  deploy-redroid    Create/reuse OCI host and install Redroid + GApps stack
  redroid-up        Start a Redroid container (Playwright-like phone)
  redroid-down      Stop and remove a Redroid container
  gapps-install     Install operator-supplied GApps zip into Redroid
  gapps-check       Validate Play/GMS packages on ADB
  verify-phone      Control API + optional GApps health on a Redroid host

Cuttlefish (ingest, spawn only when a camera stream is needed):
  deploy            Create/reuse OCI host and install Cuttlefish stack
  verify-ingest     Verify runtime + RTMP video/audio ingest

Either runtime:
  deploy-golden     Deploy a host from golden image (--platform redroid|cuttlefish)
  deploy-fleet      Deploy a pool from one golden image
  create-golden     Create golden image from a configured source instance
  prepare-golden    Prepare current host for image capture

Control plane:
  api-run           Run control API locally
  orchestrator-run  Run orchestrator locally
  test              Offline suites + dual-pool ladder (--coverage, --suite, --list, --live)
  help              Show this help

Examples:
  ./cloud-phone deploy-redroid --name redroid-source --ocpus 2 --memory 8
  GAPPS_ZIP=/opt/gapps/gapps.zip ./cloud-phone gapps-install --name redroid
  ./cloud-phone deploy-golden --platform redroid --image-id <ocid> --name phone-1
  ./cloud-phone test --coverage
  ./cloud-phone deploy --name cuttlefish-source --ocpus 4 --memory 24
  ./cloud-phone verify-ingest --vm <OCI_PUBLIC_IP>
EOF
}

run_script() {
    local script="$1"
    shift
    bash "$script" "$@"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    deploy-redroid)
        run_script "$SCRIPTS_DIR/deploy-redroid-oci.sh" "$@"
        ;;
    deploy)
        run_script "$SCRIPTS_DIR/deploy-cuttlefish-oci.sh" "$@"
        ;;
    deploy-golden)
        run_script "$SCRIPTS_DIR/deploy-from-golden.sh" "$@"
        ;;
    deploy-fleet)
        run_script "$SCRIPTS_DIR/deploy-golden-fleet.sh" "$@"
        ;;
    verify-ingest)
        run_script "$SCRIPTS_DIR/verify-cuttlefish-ingest.sh" "$@"
        ;;
    verify-phone)
        run_script "$SCRIPTS_DIR/verify-redroid-phone.sh" "$@"
        ;;
    create-golden)
        run_script "$SCRIPTS_DIR/create-golden-image.sh" "$@"
        ;;
    prepare-golden)
        run_script "$SCRIPTS_DIR/prepare-golden-image.sh" "$@"
        ;;
    redroid-up)
        run_script "$SCRIPTS_DIR/redroid-up.sh" "$@"
        ;;
    redroid-down)
        run_script "$SCRIPTS_DIR/redroid-up.sh" --down "$@"
        ;;
    gapps-install)
        run_script "$SCRIPTS_DIR/install-gapps-redroid.sh" "$@"
        ;;
    gapps-check)
        run_script "$SCRIPTS_DIR/install-gapps-redroid.sh" --validate-only "$@"
        ;;
    api-run)
        python3 "$ROOT_DIR/api/server.py" "$@"
        ;;
    orchestrator-run)
        python3 "$ROOT_DIR/orchestrator/server.py" "$@"
        ;;
    test)
        run_script "$SCRIPTS_DIR/run-tests.sh" "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
