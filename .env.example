# Cuttlefish Cloud Phone environment example

# OCI
COMPARTMENT_ID=ocid1.compartment.oc1..example
SUBNET_ID=ocid1.subnet.oc1..example
AVAILABILITY_DOMAIN=ABxx:REGION-AD-1

# SSH
SSH_KEY_FILE=~/.ssh/redroid_oci.pub
SSH_USER=ubuntu

# Optional default host used by verification scripts
VM_HOST=

# Cuttlefish defaults
CF_INSTANCE_NAME=cvd-arm64-1
CF_WEBRTC_PORT=8443

# RTMP ingest defaults
RTMP_URL=rtmp://127.0.0.1/live/cam
FRONT_SINK_URI=udp://127.0.0.1:23000?pkt_size=1316
BACK_SINK_URI=udp://127.0.0.1:23001?pkt_size=1316
MIC_SINK_URI=udp://127.0.0.1:23010?pkt_size=1316
