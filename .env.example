# Cuttlefish Cloud Phone environment example

# OCI
COMPARTMENT_ID=ocid1.compartment.oc1..example
SUBNET_ID=ocid1.subnet.oc1..example
AVAILABILITY_DOMAIN=ABxx:REGION-AD-1
OCI_PROFILE=DEFAULT

# SSH
SSH_KEY_FILE=~/.ssh/android_arm_cloud_phone_oci.pub
SSH_USER=ubuntu

# Optional default host used by verification scripts
VM_HOST=

# Cuttlefish defaults
CF_INSTANCE_NAME=cvd-arm64-1
CF_WEBRTC_PORT=8443

# RTMP ingest defaults
RTMP_URL=rtmp://127.0.0.1/live/cam
FRONT_SINK_URI=udp://127.0.0.1:23000?pkt_size=1316
BACK_SINK_URI=udp://127.0.0.1:23001?pkt_size=1316
MIC_SINK_URI=udp://127.0.0.1:23010?pkt_size=1316

# Optional API/Orchestrator settings
API_HOST=0.0.0.0
API_PORT=8080
API_TOKEN=
ORCH_HOST=0.0.0.0
ORCH_PORT=8090
ORCH_API_TOKEN=

# mock | redroid | oci  (oci = Cuttlefish ingest VMs)
ORCH_DEPLOY_MODE=mock
ORCH_MAX_INSTANCES=3
# ORCH_REDROID_DRY_RUN=1

# Redroid GApps phones (no camera devices)
REDROID_IMAGE=redroid/redroid:11.0.0-latest
REDROID_NAME=redroid
ADB_PORT=5555
# GAPPS_ZIP=/opt/gapps/gapps.zip
# GAPPS_ZIP_URL=
