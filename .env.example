# Cuttlefish Cloud Phone environment example

# OCI
COMPARTMENT_ID=ocid1.compartment.oc1..example
SUBNET_ID=ocid1.subnet.oc1..example
AVAILABILITY_DOMAIN=ABxx:REGION-AD-1
OCI_PROFILE=DEFAULT

# SSH
SSH_KEY_FILE=~/.ssh/android_arm_cloud_phone_oci.pub
SSH_USER=ubuntu

# Optional default host used by verification scripts
VM_HOST=

# Cuttlefish defaults
CF_INSTANCE_NAME=cvd-arm64-1
CF_WEBRTC_PORT=8443

# RTMP ingest defaults
RTMP_URL=rtmp://127.0.0.1/live/cam
FRONT_SINK_URI=udp://127.0.0.1:23000?pkt_size=1316
BACK_SINK_URI=udp://127.0.0.1:23001?pkt_size=1316
MIC_SINK_URI=udp://127.0.0.1:23010?pkt_size=1316

# Optional API/Orchestrator settings (never commit real tokens)
# Lab orchestrator: 129.146.105.26:8090 — see docs/OPS-ORCHESTRATOR.md
# OSLO maps CLOUD_PHONE_API_TOKEN -> ORCH_API_TOKEN and API_TOKEN
API_HOST=0.0.0.0
API_PORT=8080
API_TOKEN=
ORCH_HOST=0.0.0.0
ORCH_PORT=8090
ORCH_API_TOKEN=

# mock | redroid | oci
# oci: Redroid golden for default automation pool; Cuttlefish golden for purpose=camera
ORCH_DEPLOY_MODE=mock
# ORCH_MOCK_CAMERA_API_URL=http://127.0.0.1:8081
# CLOUD_PHONE_LIVE=1
CLOUD_PHONE_VERBOSE=1
LOG_LEVEL=DEBUG
# LOG_FORMAT=text
# LOG_FILE=/var/log/cloud-phone/control-api.log
UI_BACKEND=adb
APPIUM_URL=http://127.0.0.1:4723
VNC_PORT=5900
# VNC_WIDTH=1280
# VNC_HEIGHT=720
ORCH_MAX_INSTANCES=5
ORCH_MAX_REDROID_INSTANCES=3
ORCH_MAX_CUTTLEFISH_INSTANCES=2
# ORCH_REDROID_DRY_RUN=1

# Redroid GApps phones (default orchestrator spawn; no camera devices)
REDROID_IMAGE=redroid/redroid:11.0.0-latest
REDROID_NAME=redroid
ADB_PORT=5555
# REDROID_GOLDEN_IMAGE_ID=ocid1.image...
# GAPPS_ZIP=/opt/gapps/gapps.zip
# GAPPS_ZIP_URL=

# Cuttlefish ingest (purpose=camera only)
# CUTTLEFISH_GOLDEN_IMAGE_ID=ocid1.image...
# GOLDEN_IMAGE_ID=   # fallback for cuttlefish if CUTTLEFISH_GOLDEN_IMAGE_ID unset
