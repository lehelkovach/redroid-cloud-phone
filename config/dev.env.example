# Cloud Phone — DEV instance environment (no secrets required for the dev phone).
#
# Copy to config/dev.env and fill in the provisioned dev VM's public IP. The dev
# phone is a plain VM that tracks the `dev` branch; the orchestrator (and tests)
# read these values to reach it. config/dev.env is gitignored (matches *.env).
#
# Usage:  set -a; . config/dev.env; set +a

# --- Dev cloud-phone VM (provisioned, corresponds to the dev branch) ---
CLOUD_PHONE_DEV_HOST=               # public IP of the dev VM, e.g. 152.70.146.56
CLOUD_PHONE_DEV_SSH_USER=ubuntu
CLOUD_PHONE_DEV_SSH_KEY=~/.ssh/cloud_phone_dev   # private key whose pubkey is baked at launch
CLOUD_PHONE_DEV_INSTANCE_OCID=

# Service ports on the dev VM
CLOUD_PHONE_DEV_API_PORT=8080       # Control API
CLOUD_PHONE_DEV_WEBRTC_PORT=8443    # Cuttlefish WebRTC UI
CLOUD_PHONE_DEV_ADB_PORT=5555       # ADB (scrcpy)
CLOUD_PHONE_DEV_RTMP_PORT=1935      # OBS RTMP ingest

# Convenience: full Control API URL the orchestrator can register/route to.
# (host:api_port). Filled once CLOUD_PHONE_DEV_HOST is known.
CLOUD_PHONE_DEV_API_URL=

# --- Release orchestrator service (added later, via secrets, on main/release) ---
# ORCH_PUBLIC_URL=
# ORCH_API_TOKEN=
