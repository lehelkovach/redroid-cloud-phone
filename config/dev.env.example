# Cloud Phone — DEV instance environment (no secrets required for the dev phone).
#
# Copy to config/dev.env and fill in the provisioned dev VM's public IP. The dev
# phone is a plain VM that tracks the `dev` branch; the orchestrator (and tests)
# read these values to reach it. config/dev.env is gitignored (matches *.env).
#
# Usage:  set -a; . config/dev.env; set +a

# --- Dev cloud-phone VM (provisioned, corresponds to the dev branch) ---
# Live agent phone (2026-08): cloud-phone-agent-6c58 = 129.146.55.133 / 10.0.1.127
CLOUD_PHONE_DEV_HOST=129.146.55.133
CLOUD_PHONE_DEV_SSH_USER=ubuntu
CLOUD_PHONE_DEV_SSH_KEY=~/.ssh/oci_console
CLOUD_PHONE_DEV_INSTANCE_OCID=ocid1.instance.oc1.phx.anyhqljrgmifkaqcb7eowcjmmsqe7g53jddy4zzj2nv3p64tybe7nieptvtq
# Orchestrator VM: cloud-phone-orch-6c58 = 129.146.105.26 / 10.0.1.123
CLOUD_PHONE_ORCH_HOST=129.146.105.26
CLOUD_PHONE_ORCH_PORT=8090

# Service ports on the dev VM
CLOUD_PHONE_DEV_API_PORT=8080       # Control API
CLOUD_PHONE_DEV_WEBRTC_PORT=8443    # Cuttlefish WebRTC UI
CLOUD_PHONE_DEV_ADB_PORT=5555       # ADB (scrcpy)
CLOUD_PHONE_DEV_RTMP_PORT=1935      # OBS RTMP ingest

# Convenience: full Control API URL the orchestrator can register/route to.
# (host:api_port). Filled once CLOUD_PHONE_DEV_HOST is known.
CLOUD_PHONE_DEV_API_URL=http://10.0.1.127:8080
# From a laptop/agent outside the VCN, tunnel first then use:
# CLOUD_PHONE_DEV_API_URL=http://127.0.0.1:18080

# Orchestrator (one-phone-per-user sessions). Local mock or tunneled OCI.
# ORCH_HOST=0.0.0.0
# ORCH_PORT=8090
# ORCH_DEPLOY_MODE=mock
# ORCH_MAX_INSTANCES=1
# ORCH_REGISTER_API_URLS=${CLOUD_PHONE_DEV_API_URL}

# IPRoyal mobile proxy (founder allocates — do not commit real credentials).
# Used by Control API POST /proxy when body omits host, and by osl-oc-agent
# mobile.configure_proxy / CLOUD_PHONE_PROXY.
# IPROYAL_PROXY=http://USER:PASS@geo.iproyal.com:12321
# CLOUD_PHONE_PROXY=
# PROXY_STUB=1   # offline: scripts/proxy-control.sh records intent only

# --- Release orchestrator service (added later, via secrets, on main/release) ---
# ORCH_PUBLIC_URL=
# ORCH_API_TOKEN=
