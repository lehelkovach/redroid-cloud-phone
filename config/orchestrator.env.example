# /etc/cloud-phone/orchestrator.env  (mode 0600, root:root or cloudphone)
# Names only in the repo; fill values on the host. See docs/isolation.md.

# Required. Callers (OSLO) present it as `Authorization: Bearer ...`.
ORCH_API_TOKEN=
# Outbound token for the phones' Control API (= API_TOKEN on each phone).
ORCH_CONTROL_API_TOKEN=

# Bind: loopback (the unit default) or this host's private address.
#ORCH_HOST=10.0.0.5
# What callers should use to reach the relay (ws:// and http:// URLs are built from it).
#ORCH_PUBLIC_URL=http://10.0.0.5:8090

ORCH_DEPLOY_MODE=mock
# Browser pool: mock | local | docker
#ORCH_CHROME_RUNTIME=docker
#ORCH_CHROME_IMAGE=
#ORCH_CHROME_NETWORK=cloud-phone-browsers
#ORCH_MAX_CHROME_INSTANCES=4
# none | luks | fscrypt  (verifies; does not set up encryption)
#ORCH_PROFILE_ENCRYPTION=luks

# Relay
#ORCH_TICKET_TTL_SECONDS=300
#ORCH_RELAY_RATE=50
#ORCH_RELAY_BURST=200
# Turn off the unticketed /phones/<id>/* routes once OSLO routes through /relay.
#ORCH_REQUIRE_TICKETS=1
