# /etc/default/cloud-phone-orchestrator — the orchestrator's host settings.
# Never commit real token values.
#
# Who may call the orchestrator (OSLO sends it as CLOUD_PHONE_API_TOKEN):
ORCH_API_TOKEN=
# The token the phones' Control APIs expect (API_TOKEN on each phone host):
ORCH_CONTROL_API_TOKEN=
# static  = lease only the phones listed in ORCH_POOL_FILE (today's lab: one Redroid host, one Cuttlefish host)
# redroid = static pool first, then start Redroid containers on this host when the pool is exhausted
# oci     = static pool first, then launch OCI instances from the golden images when exhausted
ORCH_DEPLOY_MODE=static
ORCH_POOL_FILE=/etc/cloud-phone/pool.json
ORCH_STATE_FILE=/var/lib/cloud-phone-orchestrator/state.json
ORCH_MAX_REDROID_INSTANCES=3
ORCH_MAX_CUTTLEFISH_INSTANCES=2
# REDROID_GOLDEN_IMAGE_ID=
# CUTTLEFISH_GOLDEN_IMAGE_ID=
