[Unit]
Description=Cuttlefish RTMP Bridge Service
After=nginx-rtmp.service cuttlefish-launch.service
Wants=nginx-rtmp.service cuttlefish-launch.service
BindsTo=nginx-rtmp.service
PartOf=cuttlefish-cloud-phone.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/cuttlefish-cloud-phone
ExecStart=/bin/bash -lc '/opt/cloud-phone-scripts/cuttlefish-rtmp-bridge.sh --mode "${BRIDGE_MODE:-clean}" --rtmp-url "${RTMP_URL:-rtmp://127.0.0.1/live/cam}" --front-sink "${FRONT_SINK_URI:-udp://127.0.0.1:23000?pkt_size=1316}" --back-sink "${BACK_SINK_URI:-udp://127.0.0.1:23001?pkt_size=1316}" --mic-sink "${MIC_SINK_URI:-udp://127.0.0.1:23010?pkt_size=1316}" --idle-timeout "${BRIDGE_IDLE_TIMEOUT:-0}" --stall-timeout "${BRIDGE_STALL_TIMEOUT:-10}" --log-dir "${BRIDGE_LOG_DIR:-/tmp/cuttlefish-bridge}"'
# SIGTERM -> bridge cleanup -> two-stage ffmpeg stop (see stop_ffmpeg)
KillMode=mixed
TimeoutStopSec=20
Restart=always
RestartSec=5
User=root
# Clean mode decodes once and copies pixels; libx264 (encode mode) needs more.
CPUQuota=100%
MemoryMax=1024M

[Install]
WantedBy=cuttlefish-cloud-phone.target
