[Unit]
Description=Cuttlefish Launch Service
After=network-online.target
Wants=network-online.target
PartOf=cuttlefish-cloud-phone.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/cuttlefish-cloud-phone
ExecStart=/bin/bash -lc '/opt/redroid-scripts/cuttlefish-phase1-setup.sh --local --no-install --instance-name "${CF_INSTANCE_NAME:-cvd-arm64-1}" --webrtc-port "${CF_WEBRTC_PORT:-8443}"'
ExecStop=/bin/bash -lc 'cvd stop --clear_instance_dirs --instance_name "${CF_INSTANCE_NAME:-cvd-arm64-1}" >/dev/null 2>&1 || true'
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=cuttlefish-cloud-phone.target
